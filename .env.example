# EmailJS - used by the Contact form (https://dashboard.emailjs.com).
# These are public browser keys (safe to expose in the client bundle),
# but keep real values out of version control. Copy this file to .env.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
